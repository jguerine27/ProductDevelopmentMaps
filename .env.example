# Root .env — read by docker-compose.yml only. Copy to .env before
# `docker compose up`. Backend-process variables live in backend/.env.example.

# Neo4j password for the neo4j container and the backend's connection to it.
NEO4J_PASSWORD=change_me_before_deploying

# Browser origins allowed to call the API, comma-separated. In the Docker setup
# nginx serves the frontend and proxies /api, so this is the public origin of
# the deployed site.
CORS_ORIGIN=http://localhost:3000
