# Root .env - read by docker-compose.yml only. Copy to .env on the VPS and fill
# in. Backend-process variables that compose does NOT pass through live in
# backend/.env.example. backend/.env is dockerignored and never reaches the
# image; everything the container needs is set here.

# -- Required. Compose does NOT fail when these are unset: it substitutes an
# empty string and only warns. The backend is what stops - config.js exits(1)
# on a missing NEO4J_*/SESSION_SECRET, so the symptom is pdm-backend restart-
# looping while neo4j and frontend look healthy. Check: docker compose logs backend

# Neo4j password, used by the neo4j container and the backend's connection to it.
NEO4J_PASSWORD=

# HMAC key behind every session cookie. Minimum 32 characters or the backend
# exits at startup. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, which is the intended response to a compromise.
SESSION_SECRET=

# The public origin, scheme included. Must be https: NODE_ENV=production sets
# the session cookie Secure, and a browser silently discards a Secure cookie
# sent over http - sign-in appears to do nothing, with no error anywhere.
#
# Pick ONE canonical host and 301 the other at the front proxy. A cookie set on
# the apex is not sent to www., so serving both breaks the ORCID state check.
CORS_ORIGIN=https://product-development.org

# ── ORCID (the 'reviewer' role). ──
# Production, not sandbox. config.js warns at boot if this still says sandbox
# while NODE_ENV=production, but does not stop.
ORCID_BASE_URL=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Must match what is registered in the ORCID app settings BYTE FOR BYTE,
# trailing slash included - ORCID compares the string exactly.
ORCID_REDIRECT_URI=https://product-development.org/api/auth/orcid/callback

# Where the browser lands after the callback. Set explicitly so it is not
# inherited from whichever origin sorts first in CORS_ORIGIN.
ORCID_SUCCESS_REDIRECT=https://product-development.org

# ── Firebase (the 'user' role). ──
# NOT set here. The service account is mounted read-only from
# ./secrets/firebase-service-account.json - create that directory on the VPS,
# chmod 600 the file, and keep it out of git and out of the image. Leave the
# mount missing and only POST /api/auth/session/firebase answers 503; the
# public map, ORCID sign-in and every reviewer route still work.


# ══ Memory budget: OVH VPS-1, 4 GB RAM / 2 vCore / 40 GB NVMe ════════════════
#
#   Neo4j heap                1.0 GB   (initial == max, set in compose)
#   Neo4j page cache          0.5 GB
#   Neo4j JVM overhead       ~0.4 GB   metaspace, direct buffers, GC, threads
#   Node backend             ~0.3 GB
#   nginx                    ~0.03 GB
#   OS + dockerd             ~0.5 GB
#   ────────────────────────────────
#   ~2.8 GB, leaving ~1.2 GB headroom
#
# The values this file replaced (2 GB heap + 1 GB page cache) come to roughly
# 4.2 GB before the backend starts, which the OOM killer resolves by killing
# whichever process is largest - usually Neo4j, mid-write.
#
# This plan ships without swap. Add 2 GB before the first deploy so a spike
# degrades instead of killing a container:
#   fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile
#   swapon /swapfile && echo '/swapfile none swap sw 0 0' >> /etc/fstab
#
# 40 GB NVMe: container logs are capped at 10m x 3 per service in compose.
# Neo4j data lives in the named volume pdm_neo4j-data; back it up with
#   docker run --rm -v pdm_neo4j-data:/data -v $PWD:/backup alpine \
#     tar czf /backup/neo4j-$(date +%F).tar.gz /data
#
# ══ TLS ══════════════════════════════════════════════════════════════════════
#
# Nothing in this compose file terminates TLS. Both published ports bind to
# 127.0.0.1, so the VPS needs nginx or Caddy in front holding the certificate
# and proxying to 127.0.0.1:3000. Until that exists the site is unreachable
# from outside, which is the intended failure - not a half-working http site.

# ── Bind-mount footgun ───────────────────────────────────────────────────────
# Create ./secrets/firebase-service-account.json BEFORE the first `up`. If the
# path does not exist, Docker creates a DIRECTORY there, config.js reads it,
# gets EISDIR, and exits(1) - the backend restart-loops with an error that
# looks nothing like a missing file.
#   mkdir -p secrets && chmod 700 secrets
#   # paste the freshly rotated key, then:
#   chmod 600 secrets/firebase-service-account.json

# ── Frontend build-time config (CRA inlines these at `docker compose build`) ──
# Public identifiers, not secrets: they ship inside the JS bundle to every
# visitor. Firebase security rules and the Authorized-domains list are what
# protect the project - copy these from dynacart/.env.
#
# Changing any of them requires a REBUILD, not a restart: `docker compose up -d`
# alone reuses the existing image and the old values stay baked in.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
