# Copy to backend/.env and fill in. Never commit backend/.env — it is gitignored.
# Every variable read by backend/config.js is listed here.

# ── Required. The process exits at startup if any of these is missing. ──
# Local dev with Neo4j Desktop: bolt://localhost:7687
# Docker Compose (backend container -> neo4j container): bolt://neo4j:7687
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password

# ── Optional, shown with their defaults. ──
# Port the API listens on.
PORT=4000

# development | production. Affects logging verbosity only.
NODE_ENV=development

# Comma-separated allow-list of browser origins permitted to call the API.
# Replaces the old wide-open `cors()`. The CRA dev server is the default; in
# Docker, nginx serves the frontend and proxies /api, so set this to the public
# origin of the deployed site.
CORS_ORIGIN=http://localhost:3000

# Neo4j database name. Leave blank to use the server's default database.
NEO4J_DATABASE=
