# Copy to backend/.env and fill in. Never commit backend/.env — it is gitignored.
# Every variable read by backend/config.js is listed here.

# ── Required. The process exits at startup if any of these is missing. ──
# Local dev with Neo4j Desktop: bolt://localhost:7687
# Docker Compose (backend container -> neo4j container): bolt://neo4j:7687
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password

# HMAC key signing every session cookie. At least 32 characters or the process
# exits. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every existing session, which is the intended way to
# sign everyone out after a suspected compromise.
SESSION_SECRET=replace-me-with-48-random-bytes-base64url-encoded

# ── Optional, shown with their defaults. ──
# Port the API listens on.
PORT=4000

# development | production. Affects logging verbosity only.
NODE_ENV=development

# Comma-separated allow-list of browser origins permitted to call the API.
# Replaces the old wide-open `cors()`. The CRA dev server is the default; in
# Docker, nginx serves the frontend and proxies /api, so set this to the public
# origin of the deployed site.
CORS_ORIGIN=http://localhost:3000

# Neo4j database name. Leave blank to use the server's default database.
NEO4J_DATABASE=

# ── Firebase (the 'user' role). Optional. ──
# Server-side ID-token verification. The frontend's route guards only shape the
# UI; they are not security, so the token is verified here with firebase-admin.
# Leave both blank and POST /api/auth/session/firebase answers 503 while
# everything else — the public map, ORCID sign-in, all reviewer routes — works.
#
# PREFER THE PATH. Download the JSON from the Firebase console (Project settings
# -> Service accounts -> Generate new private key), save it beside this file, and
# point at it. The filename patterns *service-account*.json and
# serviceAccountKey.json are gitignored; the key inside grants admin access to
# the entire Firebase project, so treat it exactly like a password.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# The inline alternative, for deployments that inject env vars rather than files.
#
# IT MUST BE ON ONE LINE, IN SINGLE QUOTES. dotenv does not read unquoted
# multi-line values — it stops at the first newline — so pasting the downloaded
# JSON across several lines silently sets this to "{" and the server refuses to
# start. Single quotes because the JSON is full of double quotes.
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...",...}'
FIREBASE_SERVICE_ACCOUNT=

# ── ORCID (the 'reviewer' role). Optional. ──
# OAuth 2.0 authorization-code flow, scope /authenticate only — it returns the
# ORCID iD and name, which is all that is needed. Do not request read or write
# scopes.
#
# Sandbox for development, https://orcid.org for production. Read from env and
# never hard-coded, so promotion is a configuration change. The code exchange
# happens server-side; ORCID_CLIENT_SECRET must never reach the browser.
#
# SECURITY NOTE: an earlier backend/.env carrying real ORCID credentials was
# committed to this repository (commit 5f123c1, reachable from origin/ORCID-main
# and origin/Orcid-API on a public remote). Those credentials are published and
# must be rotated at orcid.org before this flow is used in anger — deleting the
# file did not remove it from git history.
ORCID_BASE_URL=https://sandbox.orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:4000/api/auth/orcid/callback

# Where the browser is sent after the ORCID callback completes. Defaults to the
# first entry in CORS_ORIGIN.
ORCID_SUCCESS_REDIRECT=
